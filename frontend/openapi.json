{
  "components": {
    "schemas": {
      "AuthLevel": {
        "description": "How strongly a session has been authenticated.",
        "enum": [
          "password",
          "full"
        ],
        "title": "AuthLevel",
        "type": "string"
      },
      "AuthStateResponse": {
        "properties": {
          "auth_level": {
            "$ref": "#/components/schemas/AuthLevel"
          },
          "next_step": {
            "$ref": "#/components/schemas/NextStep"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "auth_level",
          "next_step"
        ],
        "title": "AuthStateResponse",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 256,
            "minLength": 12,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^\\S+@\\S+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MfaCodeRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "MfaCodeRequest",
        "type": "object"
      },
      "ModuleInfo": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "description"
        ],
        "title": "ModuleInfo",
        "type": "object"
      },
      "NextStep": {
        "enum": [
          "none",
          "mfa_verify",
          "mfa_enroll"
        ],
        "title": "NextStep",
        "type": "string"
      },
      "Role": {
        "enum": [
          "viewer",
          "member",
          "admin",
          "owner"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionOut": {
        "properties": {
          "auth_level": {
            "$ref": "#/components/schemas/AuthLevel"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ip_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "expires_at",
          "auth_level",
          "user_agent",
          "ip_address",
          "current"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SystemInfoResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "mfa_required": {
            "title": "Mfa Required",
            "type": "boolean"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleInfo"
            },
            "title": "Modules",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "environment",
          "server_time",
          "mfa_required",
          "modules"
        ],
        "title": "SystemInfoResponse",
        "type": "object"
      },
      "TotpEnrollmentResponse": {
        "properties": {
          "provisioning_uri": {
            "title": "Provisioning Uri",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "secret",
          "provisioning_uri"
        ],
        "title": "TotpEnrollmentResponse",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
