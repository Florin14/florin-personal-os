            "title": "Last Login At"
          },
          "mfa_enabled": {
            "title": "Mfa Enabled",
            "type": "boolean"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "timezone",
          "mfa_enabled",
          "last_login_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "WorkspaceKind": {
        "enum": [
          "personal",
          "business"
        ],
        "title": "WorkspaceKind",
        "type": "string"
      },
      "WorkspaceOut": {
        "properties": {
          "default_currency": {
            "title": "Default Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/WorkspaceKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "kind",
          "timezone",
          "default_currency",
          "role"
        ],
        "title": "WorkspaceOut",
        "type": "object"
      }
    }
  },
