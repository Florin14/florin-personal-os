# Personal OS environment configuration.
# Copy to `.env` and fill in the values. Never commit `.env`.

# --- PostgreSQL (container) --------------------------------------------------
POSTGRES_USER=personal_os
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=personal_os
# Host port for local tools (bound to 127.0.0.1 only, development compose).
POSTGRES_HOST_PORT=5433

# --- Security ----------------------------------------------------------------
# Comma-separated Fernet keys. The first encrypts; all decrypt (key rotation).
# Generate one with either:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   docker compose run --rm --no-deps backend python -m app.cli generate-key   (after the first build)
ENCRYPTION_KEYS=

# Browser origins allowed to make state-changing requests (no trailing slash).
# Production example: https://pos.example.internal
ALLOWED_ORIGINS=http://localhost:3000

# Optional TOTP enrollment for local testing (always required in production).
AUTH_REQUIRE_MFA=false

# Optional tuning (defaults shown)
# SESSION_IDLE_TIMEOUT_MINUTES=720
# SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO

# Public (VPN) URL of the web app, used for links in Discord messages.
# PUBLIC_APP_URL=https://pos.example.internal

# --- Production only (compose.prod.yaml) --------------------------------------
# Host interface the web container binds to, e.g. the WireGuard address 10.8.0.1.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# --- Optional AI (ADR-023) ----------------------------------------------------
# Disabled by default. "ollama" uses a local Ollama server (free, data stays on the host).
# No paid cloud provider is supported without an approved ADR.
# AI_PROVIDER=disabled
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2
# AI_TIMEOUT_SECONDS=90
# AI_MONTHLY_REQUEST_BUDGET=200
